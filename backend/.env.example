PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/echo8v
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SITE_ORIGIN=http://localhost:5173
NODE_ENV=development
ADMIN_NAME=Justice Yakubu Jatau
ADMIN_EMAIL=jataujustice200@gmail.com
ADMIN_PASSWORD=

# Backblaze public website-media bucket. No local fallback for new uploads.
B2_ENDPOINT=https://s3.YOUR_REGION.backblazeb2.com
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Bucket root, e.g. https://s3.us-west-004.backblazeb2.com/your-bucket
B2_PUBLIC_URL=

# Resend: verified sender domain; notification destination can be Gmail.
RESEND_API_KEY=
RESEND_FROM=Echo8V <notifications@echo8v.com>
ENQUIRY_NOTIFICATION_TO=jataujustice200@gmail.com
